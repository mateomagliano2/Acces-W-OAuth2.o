generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String?  // Opcional para los que se registran con Google
  googleId  String?  @unique
  name      String?
  avatar    String?
  createdAt DateTime @default(now())
}